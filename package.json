{
  "name": "betzone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "platform": "tsx server/platform.ts",
    "ingest": "tsx server/ingest/run.ts",
    "ingest:once": "tsx server/ingest/run.ts --once",
    "sports:check": "tsx server/tools/check.ts",
    "dev:all": "concurrently -n web,platform,ingest -c red,green,blue \"next dev --hostname 0.0.0.0\" \"tsx server/platform.ts\" \"tsx server/ingest/run.ts\"",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "dotenv": "^18.0.9",
    "framer-motion": "^11.11.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.0",
    "socket.io-client": "^4.8.0",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}