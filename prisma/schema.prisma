Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬
model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  currency  String   @default("GHS")
  balance   Decimal  @default(0) @db.Decimal(14, 2)
  version   Int      @default(0)
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id             String           @id @default(cuid())
  userId         String
  walletId       String
  type           TxType
  status         TxStatus
  amount         Decimal          @db.Decimal(14, 2)
  balanceAfter   Decimal?         @db.Decimal(14, 2)
  currency       String           @default("GHS")
  provider       PaymentProvider?
  providerRef    String?          @unique
  idempotencyKey String           @unique
  ticketId       String?
  counterparty   String?
  failureReason  String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?

  user   User       @relation(fields: [userId], references: [id])
  wallet Wallet     @relation(fields: [walletId], references: [id])
  ticket BetTicket? @relation(fields: [ticketId], references: [id])

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([type, status])
  @@index([ticketId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

