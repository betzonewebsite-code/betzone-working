// BETZONE production schema. Money is Decimal (never float).
// Transaction amounts are signed (+credit / -debit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

