generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String                 @id @default(cuid())
  phone             String                 @unique
  passwordHash      String
  withdrawalPinHash String?
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?              @db.Date
  role              UserRole               @default(USER)
  status            UserStatus             @default(ACTIVE)
  kycStatus         KycStatus              @default(NONE)
  phoneVerifiedAt   DateTime?
  failedLoginCount  Int                    @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  email             String                 @unique
  emailVerifiedAt   DateTime?
  auditLogs         AuditLog[]
  tickets           BetTicket[]
  bookingCodes      BookingCode[]
  feedPosts         FeedPost[]
  feedReports       FeedReport[]
  jackpotEntries    JackpotEntry[]
  otpCodes          OtpCode[]
  limits            ResponsibleLimits?
  sessions          Session[]
  transactions      Transaction[]
  virtualSessions   VirtualTicketSession[]
  wallet            Wallet?
}

model OtpCode {
  id         String     @id @default(cuid())
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime   @default(now())
  channel    OtpChannel
  target     String
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  familyId   String
  tokenHash  String    @unique
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  currency     String        @default("GHS")
  balance      Decimal       @default(0) @db.Decimal(14, 2)
  version      Int           @default(0)
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  user         User          @relation(fields: [userId], references: [id])
}

model Transaction {
  id             String           @id @default(cuid())
  userId         String
  walletId       String
  type           TxType
  status         TxStatus
  amount         Decimal          @db.Decimal(14, 2)
  balanceAfter   Decimal?         @db.Decimal(14, 2)
  currency       String           @default("GHS")
  provider       PaymentProvider?
  providerRef    String?          @unique
  idempotencyKey String           @unique
  ticketId       String?
  counterparty   String?
  failureReason  String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  ticket         BetTicket?       @relation(fields: [ticketId], references: [id])
  user           User             @relation(fields: [userId], references: [id])
  wallet         Wallet           @relation(fields: [walletId], references: [id])

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([type, status])
  @@index([ticketId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
}

model League {
  id         String    @id @default(cuid())
  source     String
  externalId String
  sport      Sport
  country    String
  name       String
  isPopular  Boolean   @default(false)
  sortOrder  Int       @default(1000)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  fixtures   Fixture[]

  @@unique([source, externalId])
  @@index([sport, isPopular])
}

model Fixture {
  id             String         @id @default(cuid())
  source         String
  externalId     String
  leagueId       String
  sport          Sport
  homeTeam       String
  awayTeam       String
  kickoffAt      DateTime
  status         FixtureStatus  @default(SCHEDULED)
  minute         Int?
  period         String?
  homeScore      Int            @default(0)
  awayScore      Int            @default(0)
  result         Json?
  bettingOpen    Boolean        @default(true)
  lastSyncedAt   DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  legs           BetLeg[]
  league         League         @relation(fields: [leagueId], references: [id])
  jackpotMatches JackpotMatch[]
  markets        Market[]

  @@unique([source, externalId])
  @@index([status, kickoffAt])
  @@index([leagueId, kickoffAt])
  @@index([sport, status])
}

model Market {
  id              String       @id @default(cuid())
  fixtureId       String
  type            MarketType
  line            Decimal?     @db.Decimal(5, 2)
  lineKey         String       @default("")
  name            String
  status          MarketStatus @default(OPEN)
  suspendedReason String?
  settledAt       DateTime?
  updatedAt       DateTime     @updatedAt
  legs            BetLeg[]
  fixture         Fixture      @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  odds            MarketOdds[]

  @@unique([fixtureId, type, lineKey])
  @@index([fixtureId, status])
}

model MarketOdds {
  id           String          @id @default(cuid())
  marketId     String
  key          String
  label        String
  odds         Decimal         @db.Decimal(8, 3)
  previousOdds Decimal?        @db.Decimal(8, 3)
  status       OddsStatus      @default(OPEN)
  result       SelectionResult @default(PENDING)
  updatedAt    DateTime        @updatedAt
  legs         BetLeg[]
  market       Market          @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@unique([marketId, key])
}

model BetTicket {
  id                String                @id @default(cuid())
  publicId          String                @unique
  userId            String
  type              TicketType
  flexiCut          Int                   @default(0)
  stake             Decimal               @db.Decimal(14, 2)
  remainingStake    Decimal               @db.Decimal(14, 2)
  totalOdds         Decimal               @db.Decimal(14, 3)
  bonusPct          Decimal               @default(0) @db.Decimal(5, 2)
  potentialPayout   Decimal               @db.Decimal(14, 2)
  payout            Decimal               @default(0) @db.Decimal(14, 2)
  cashedOutAmount   Decimal               @default(0) @db.Decimal(14, 2)
  autoCashoutTarget Decimal?              @db.Decimal(14, 2)
  status            TicketStatus          @default(OPEN)
  idempotencyKey    String
  placedAt          DateTime              @default(now())
  settledAt         DateTime?
  isVirtual         Boolean               @default(false)
  legs              BetLeg[]
  user              User                  @relation(fields: [userId], references: [id])
  transactions      Transaction[]
  virtualSession    VirtualTicketSession?

  @@unique([userId, idempotencyKey])
  @@index([userId, status, placedAt])
  @@index([status, placedAt])
}

model BetLeg {
  id         String          @id @default(cuid())
  ticketId   String
  fixtureId  String
  marketId   String
  oddsId     String
  oddsTaken  Decimal         @db.Decimal(8, 3)
  matchName  String
  marketName String
  pickLabel  String
  line       Decimal?        @db.Decimal(5, 2)
  placedLive Boolean         @default(false)
  result     SelectionResult @default(PENDING)
  settledAt  DateTime?
  fixture    Fixture         @relation(fields: [fixtureId], references: [id])
  market     Market          @relation(fields: [marketId], references: [id])
  odds       MarketOdds      @relation(fields: [oddsId], references: [id])
  ticket     BetTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([fixtureId, result])
}

model BookingCode {
  code      String   @id
  userId    String?
  legs      Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User?    @relation(fields: [userId], references: [id])

  @@index([expiresAt])
}

model ResponsibleLimits {
  id                String    @id @default(cuid())
  userId            String    @unique
  dailyDeposit      Decimal?  @db.Decimal(14, 2)
  weeklyDeposit     Decimal?  @db.Decimal(14, 2)
  monthlyDeposit    Decimal?  @db.Decimal(14, 2)
  dailyStake        Decimal?  @db.Decimal(14, 2)
  coolOffUntil      DateTime?
  selfExcludedUntil DateTime?
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model JackpotRound {
  id           String         @id @default(cuid())
  title        String
  status       JackpotStatus  @default(OPEN)
  entryFee     Decimal        @db.Decimal(14, 2)
  seed         Decimal        @default(0) @db.Decimal(14, 2)
  carryOver    Decimal        @default(0) @db.Decimal(14, 2)
  carryClaimed Boolean        @default(false)
  closesAt     DateTime
  settledAt    DateTime?
  createdAt    DateTime       @default(now())
  entries      JackpotEntry[]
  matches      JackpotMatch[]

  @@index([status, closesAt])
}

model JackpotMatch {
  id        String       @id @default(cuid())
  roundId   String
  fixtureId String
  position  Int
  fixture   Fixture      @relation(fields: [fixtureId], references: [id])
  round     JackpotRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, fixtureId])
}

model JackpotEntry {
  id             String       @id @default(cuid())
  roundId        String
  userId         String
  picks          Json
  correct        Int?
  payout         Decimal      @default(0) @db.Decimal(14, 2)
  idempotencyKey String
  createdAt      DateTime     @default(now())
  round          JackpotRound @relation(fields: [roundId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([roundId])
  @@index([userId, createdAt])
}

model FeedPost {
  id         String       @id @default(cuid())
  userId     String
  code       String
  note       String
  hidden     Boolean      @default(false)
  reports    Int          @default(0)
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id])
  reportRows FeedReport[]

  @@index([hidden, createdAt])
}

model FeedReport {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model VirtualRound {
  id          String        @id @default(cuid())
  number      Int           @unique
  seedHash    String
  seed        String
  status      VirtualStatus @default(BETTING)
  betsCloseAt DateTime
  endsAt      DateTime
  matches     Json
  createdAt   DateTime      @default(now())

  @@index([status, number])
}

model VirtualTicketSession {
  id         String    @id @default(cuid())
  ticketId   String    @unique
  userId     String
  status     String    @default("READY")
  fixtureIds Json
  startedAt  DateTime?
  endsAt     DateTime?
  createdAt  DateTime  @default(now())
  results    Json?
  seed       String?
  seedHash   String?
  ticket     BetTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  SELF_EXCLUDED
  CLOSED
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
  WITHDRAWAL_PIN
}

enum OtpChannel {
  EMAIL
  SMS
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  BET_STAKE
  BET_PAYOUT
  BET_REFUND
  CASHOUT
  BONUS
  ADJUSTMENT
}

enum TxStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
  MTN_MOMO
  TELECEL_CASH
  AIRTELTIGO_MONEY
  MPESA
  CARD
  INTERNAL
}

enum Sport {
  SOCCER
  BASKETBALL
  TENNIS
  TABLE_TENNIS
  ICE_HOCKEY
  BASEBALL
  ESPORTS
}

enum FixtureStatus {
  SCHEDULED
  LIVE
  HALFTIME
  FINISHED
  POSTPONED
  CANCELLED
  ABANDONED
}

enum MarketType {
  ONE_X_TWO
  OVER_UNDER
  DOUBLE_CHANCE
  BTTS
  NEXT_GOAL
  ASIAN_HANDICAP
  MONEYLINE
  CORRECT_SCORE
  TEAM_TOTALS
  HALF_TIME_RESULT
  HALF_TIME_FULL_TIME
  WIN_MARGIN
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
  VOID
}

enum OddsStatus {
  OPEN
  SUSPENDED
}

enum SelectionResult {
  PENDING
  WON
  LOST
  VOID
  HALF_WON
  HALF_LOST
}

enum TicketType {
  SINGLE
  MULTIPLE
  FLEXI
  SYSTEM
}

enum TicketStatus {
  OPEN
  WON
  LOST
  VOID
  CASHED_OUT
}

enum JackpotStatus {
  OPEN
  CLOSED
  SETTLED
  CANCELLED
}

enum VirtualStatus {
  BETTING
  PLAYING
  DONE
}
