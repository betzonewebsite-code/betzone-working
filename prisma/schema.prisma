Æ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬
enum JackpotStatus {
  OPEN
  CLOSED
  SETTLED
  CANCELLED
}

model JackpotRound {
  id           String        @id @default(cuid())
  title        String
  status       JackpotStatus @default(OPEN)
  entryFee     Decimal       @db.Decimal(14, 2)
  seed         Decimal       @default(0) @db.Decimal(14, 2)
  carryOver    Decimal       @default(0) @db.Decimal(14, 2)
  carryClaimed Boolean       @default(false)
  closesAt     DateTime
  settledAt    DateTime?
  createdAt    DateTime      @default(now())

  matches JackpotMatch[]
  entries JackpotEntry[]

  @@index([status, closesAt])
}

model JackpotMatch {
  id        String @id @default(cuid())
  roundId   String
  fixtureId String
  position  Int

  round   JackpotRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  fixture Fixture      @relation(fields: [fixtureId], references: [id])

  @@unique([roundId, fixtureId])
}

model JackpotEntry {
  id             String   @id @default(cuid())
  roundId        String
  userId         String
  picks          Json
  correct        Int?
  payout         Decimal  @default(0) @db.Decimal(14, 2)
  idempotencyKey String
  createdAt      DateTime @default(now())

  round JackpotRound @relation(fields: [roundId], references: [id])
  user  User         @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([roundId])
  @@index([userId, createdAt])
}

