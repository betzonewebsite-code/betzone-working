â€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€šÃ‚ÂÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬
enum VirtualStatus {
  BETTING
  PLAYING
  DONE
}

model VirtualRound {
  id          String        @id @default(cuid())
  number      Int           @unique
  seedHash    String
  seed        String
  status      VirtualStatus @default(BETTING)
  betsCloseAt DateTime
  endsAt      DateTime
  matches     Json
  createdAt   DateTime      @default(now())

  @@index([status, number])
}

model VirtualTicketSession {
  id          String   @id @default(cuid())
  ticketId    String   @unique
  userId      String
  status      String   @default("READY")
  fixtureIds  Json
  seed        String?
  seedHash    String?
  results     Json?
  startedAt   DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())

  ticket BetTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
}



