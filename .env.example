# ── Copy to .env (Prisma CLI, Next.js and the server process all read .env). Never commit .env. ──
NODE_ENV=development

# Database + queue (matches docker-compose.yml)
DATABASE_URL=postgresql://betzone:betzone_dev_pw@localhost:5432/betzone?schema=public
REDIS_URL=redis://localhost:6379

# Auth. Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5

# Email verification (PRIMARY). "console" prints the code in the server log (development only, refused in production).
EMAIL_PROVIDER=console        # console | brevo
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com   # must be a verified sender in Brevo
EMAIL_FROM_NAME=BetZone

# SMS (SECONDARY / fallback). Only used when the player taps "send by SMS instead". "console" prints the code in the server log (development only, refused in production).
SMS_PROVIDER=console          # console | arkesel | twilio
SMS_API_KEY=
SMS_SENDER_ID=BetZone
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Sports data. Betting use needs a commercial plan from each provider. Check their terms.
SPORTS_PRIMARY=sportsgameodds      # odds + live scores + status
SPORTS_SECONDARY=the-odds-api      # double-checks final scores before settlement (or "none")
SPORTSGAMEODDS_API_KEY=
SGO_BOOKMAKERS=pinnacle,bet365     # preferred bookmaker price sources, in order
ODDS_API_KEY=
ODDS_API_REGIONS=uk,eu
SPORTS_LEAGUES=EPL,UCL,LALIGA,SERIEA,BUNDESLIGA,LIGUE1,NBA
SPORTS_POLL_LIVE_SEC=15            # lower = fresher odds but more API calls
SPORTS_POLL_UPCOMING_SEC=600

# Payments (Paystack supports mobile money and cards in Ghana. Gambling merchants need approval.)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Betting and money rules (amounts are in DEFAULT_CURRENCY)
LIVE_BET_DELAY_SEC=5
MIN_STAKE=1
MAX_STAKE=10000
MAX_PAYOUT=500000
CASHOUT_MARGIN_PCT=5
DEPOSIT_MIN=1
DEPOSIT_MAX=10000
WITHDRAWAL_MIN=5
WITHDRAWAL_AUTO_APPROVE_MAX=500   # larger withdrawals wait for an admin to approve
WITHDRAWAL_DAILY_MAX=5000
WITHDRAWAL_KYC_ABOVE=1000

# Instant Virtuals (BetZone-run virtual football). Off by default. Turn on for development; for production get the random number generator independently certified first.
VIRTUALS_ENABLED=false
VIRTUALS_MARGIN_PCT=10             # the house edge: players get back about 100/(100+margin) of what they stake over time
VIRTUALS_BETTING_SEC=60
VIRTUALS_PLAY_SEC=30

# Jackpot: share of entry fees kept by the house (the rest forms the prize pool)
JACKPOT_HOUSE_PCT=20

# Games and virtual sports come from a licensed provider. Fill these in only after you have a contract.
GAMES_WALLET_SECRET=
GAMES_CATALOG=[]                   # JSON: [{"id":"g1","title":"...","category":"crash","thumb":"https://...","launchUrl":"https://provider/launch?token={token}"}]

# App
DEFAULT_CURRENCY=GHS
COUNTRY_CODE=GH               # default region for phone number parsing
MIN_AGE=18
CLIENT_ORIGIN=http://localhost:3000
SOCKET_PORT=4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
